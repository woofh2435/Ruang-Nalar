{
  "name": "ruang-nalar",
  "private": true,
  "version": "1.0.0",
  "description": "Ruang Nalar — perpustakaan ebook interaktif catatan kuliah Sosiologi, bermaskot bunglon Nalar, bergaya lukisan Van Gogh.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:docs": "tsc --noEmit && vite build --outDir docs --emptyOutDir",
    "bundel:fungsi": "node scripts/bundel-fungsi.mjs",
    "test:edge": "deno test --allow-env --allow-read supabase/tests/edge_test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "framer-motion": "^11.11.17",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
